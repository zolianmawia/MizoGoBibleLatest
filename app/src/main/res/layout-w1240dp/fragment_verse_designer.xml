<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <androidx.cardview.widget.CardView
        android:id="@+id/card_preview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toTopOf="@+id/layout_controls"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/layout_capture"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/img_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/side_nav_bar" />

            <View
                android:id="@+id/view_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#40000000" />

            <FrameLayout
                android:id="@+id/layout_text_canvas"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="16dp">

                <EditText
                    android:id="@+id/edit_verse_preview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_text_edit_border"
                    android:gravity="center"
                    android:inputType="textMultiLine"
                    android:padding="12dp"
                    android:text="A tirin Pathianin..."
                    android:textColor="@android:color/white"
                    android:textSize="22sp"
                    android:textStyle="italic"
                    android:minWidth="100dp" />

                <EditText
                    android:id="@+id/edit_reference_preview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="40dp"
                    android:background="@drawable/bg_text_edit_border"
                    android:gravity="center"
                    android:inputType="text"
                    android:padding="8dp"
                    android:text="John 3:16"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </FrameLayout>
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <!-- Floating Font Dialog -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/floating_font_dialog"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:cardCornerRadius="16dp"
        app:cardElevation="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/colorPrimary">
        <include android:id="@+id/font_dialog_content" layout="@layout/dialog_verse_font_settings" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Floating Color Dialog -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/floating_color_dialog"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:cardCornerRadius="16dp"
        app:cardElevation="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/colorPrimary">
        <include android:id="@+id/color_dialog_content" layout="@layout/dialog_verse_color_picker" />
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/layout_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_pick_image"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="Background"
                    app:icon="@drawable/ic_gallery_black_24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_pick_font"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="Font &amp; Style"
                    app:icon="@drawable/ic_text_fields_24" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_pick_color"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Color"
                    app:icon="@drawable/bg_color_selected" />
            </LinearLayout>
        </HorizontalScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_share_designed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            android:padding="12dp"
            android:text="Share as Image"
            app:icon="@drawable/ic_share_24" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>