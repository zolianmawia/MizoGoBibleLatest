<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/pin_popup_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardCornerRadius="28dp"
        app:cardElevation="8dp"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/colorOutlineVariant"
        app:cardBackgroundColor="?attr/colorSurfaceContainer">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="6dp"
            android:gravity="center">

            <ImageView
                android:id="@+id/pin_red"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="2dp"
                android:padding="8dp"
                android:src="@drawable/ic_pin_24"
                app:tint="#FF5252"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Red Pin" />

            <ImageView
                android:id="@+id/pin_blue"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="2dp"
                android:padding="8dp"
                android:src="@drawable/ic_pin_24"
                app:tint="#448AFF"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Blue Pin" />

            <ImageView
                android:id="@+id/pin_green"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="2dp"
                android:padding="8dp"
                android:src="@drawable/ic_pin_24"
                app:tint="#4CAF50"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Green Pin" />

            <ImageView
                android:id="@+id/pin_yellow"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="2dp"
                android:padding="8dp"
                android:src="@drawable/ic_pin_24"
                app:tint="#FFD740"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Yellow Pin" />

            <ImageView
                android:id="@+id/pin_purple"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_margin="2dp"
                android:padding="8dp"
                android:src="@drawable/ic_pin_24"
                app:tint="#E040FB"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Purple Pin" />

            <View
                android:layout_width="1dp"
                android:layout_height="28dp"
                android:layout_marginHorizontal="6dp"
                android:background="?attr/colorOutlineVariant" />

            <ImageView
                android:id="@+id/btn_open_pin_list"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="9dp"
                android:src="@drawable/ic_menu_book_24"
                app:tint="?attr/colorPrimary"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Pin List" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
