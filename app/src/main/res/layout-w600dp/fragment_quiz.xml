<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/quizRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 1. Background Dim View -->
    <View
        android:id="@+id/quizDimBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#AA000000"
        android:clickable="false"
        android:focusable="false" />

    <!-- 2. MAIN QUIZ WINDOW -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/quizWindowCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardBackgroundColor="#000022"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:strokeColor="#00A2FF"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/quizHeaderBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:background="#22FFFFFF">

                <TextView
                    android:id="@+id/textQuizTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="BIBLE QUIZ"
                    android:textColor="#00A2FF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/btnMinimize"
                    app:layout_constraintHorizontal_bias="0.0" />

                <ImageView
                    android:id="@+id/btnMinimize"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_remove_24"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="#00A2FF"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/btnClose" />

                <ImageView
                    android:id="@+id/btnClose"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_close_24"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="#FF4444"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/quizBodyContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp">

                <!-- Point Label & Points thup tawh a ni -->
                <TextView
                    android:id="@+id/textPointsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Points:"
                    android:textColor="#FFD700"
                    android:textSize="14sp"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/textPoints" />

                <TextView
                    android:id="@+id/textPoints"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:text="0"
                    android:textColor="#FFD700"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/textTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="60"
                    android:textColor="#FF4444"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/textQuestionCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Question: 1/10"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    app:layout_constraintTop_toBottomOf="@id/textTimer"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <FrameLayout
                    android:id="@+id/layoutQuestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="60dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_quiz_box"
                    android:padding="12dp"
                    app:layout_constraintTop_toBottomOf="@id/textQuestionCount">

                    <TextView
                        android:id="@+id/textQuestion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/zawhna"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp" />
                </FrameLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOptionA"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="4dp"
                    android:layout_marginTop="4dp"
                    android:text="@string/a"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/ans"
                    app:backgroundTint="@null"
                    android:textAllCaps="false"
                    app:layout_constraintTop_toBottomOf="@id/layoutQuestion"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/btnOptionB"
                    app:layout_constraintHorizontal_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOptionB"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="4dp"
                    android:text="@string/b"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/ans"
                    app:backgroundTint="@null"
                    android:textAllCaps="false"
                    app:layout_constraintTop_toBottomOf="@id/layoutQuestion"
                    app:layout_constraintStart_toEndOf="@+id/btnOptionA"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOptionC"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="4dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/c"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/ans"
                    app:backgroundTint="@null"
                    android:textAllCaps="false"
                    app:layout_constraintTop_toBottomOf="@id/btnOptionA"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/btnOptionD"
                    app:layout_constraintHorizontal_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOptionD"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/d"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/ans"
                    app:backgroundTint="@null"
                    android:textAllCaps="false"
                    app:layout_constraintTop_toBottomOf="@id/btnOptionB"
                    app:layout_constraintStart_toEndOf="@+id/btnOptionC"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNext"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="NEXT QUESTION"
                    android:visibility="gone"
                    android:backgroundTint="#00A2FF"
                    android:textColor="#FFFFFF"
                    app:layout_constraintTop_toBottomOf="@id/btnOptionC"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <ProgressBar
                    android:id="@+id/progressLoading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 3. QUIZ INSTRUCTIONS CARD -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/instructionsCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        app:cardBackgroundColor="#000044"
        app:cardCornerRadius="24dp"
        app:cardElevation="15dp"
        app:strokeColor="#00A2FF"
        app:strokeWidth="1.5dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="BIBLE QUIZ KALPHUNG"
                android:textColor="#00A2FF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="20dp" />

            <TextView
                android:id="@+id/textQuizInstructions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/quiz_notes"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:lineSpacingExtra="10dp"
                android:layout_marginBottom="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartQuizMain"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:text="TAN RAWH LE"
                android:textSize="18sp"
                android:textStyle="bold"
                android:backgroundTint="#00A2FF"
                android:textColor="#FFFFFF"
                android:clickable="true"
                android:focusable="true"
                app:cornerRadius="16dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>