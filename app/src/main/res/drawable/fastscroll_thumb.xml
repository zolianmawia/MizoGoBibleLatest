<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <layer-list>
            <!-- Background Pill (Gold for visibility) -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#FFD700" />
                    <stroke android:width="2dp" android:color="#FFFFFF" />
                    <corners android:radius="100dp" />
                    <size android:width="26dp" android:height="120dp" />
                </shape>
            </item>

            <!-- Grip lines -->
            <item android:top="40dp" android:bottom="40dp" android:left="6dp" android:right="6dp">
                <shape android:shape="rectangle">
                    <stroke android:width="1dp" android:color="#80000000" />
                    <size android:height="1dp" />
                </shape>
            </item>
            <item android:top="55dp" android:bottom="55dp" android:left="6dp" android:right="6dp">
                <shape android:shape="rectangle">
                    <stroke android:width="1dp" android:color="#80000000" />
                    <size android:height="1dp" />
                </shape>
            </item>
            <item android:top="70dp" android:bottom="70dp" android:left="6dp" android:right="6dp">
                <shape android:shape="rectangle">
                    <stroke android:width="1dp" android:color="#80000000" />
                    <size android:height="1dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>