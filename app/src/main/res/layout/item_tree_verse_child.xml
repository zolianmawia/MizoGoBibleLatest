<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_verse_child"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground">

    <CheckBox
        android:id="@+id/checkbox_select"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <com.zoliana.khampat.mizobible.ui.common.TreeConnectorView
        android:id="@+id/tree_connector"
        android:layout_width="72dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toEndOf="@+id/checkbox_select"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="5dp"
        android:paddingBottom="13dp"
        android:paddingEnd="12dp"
        app:layout_constraintStart_toEndOf="@+id/tree_connector"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/text_child_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_title_pill"
            android:drawableStart="@drawable/ic_label_16"
            android:drawablePadding="5dp"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:textColor="?attr/colorOnSecondaryContainer"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="Hun Serh a ka chhiar tur"
            tools:visibility="visible" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/text_verse_content"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:lineSpacingExtra="3.5dp"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14.5sp"
                android:paddingEnd="6dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/btn_verse_more"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Roreltute 18:29 ²⁹ Tin, a khaw hmingah chuan..." />

            <ImageView
                android:id="@+id/btn_verse_more"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_more_horiz_24"
                app:tint="?attr/colorPrimary"
                android:contentDescription="Bookmark options"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/text_verse_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="sans-serif"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp"
            android:textStyle="italic"
            android:visibility="gone"
            tools:text="Note: Ka chhiar tur..." />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
