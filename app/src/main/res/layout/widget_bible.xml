<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_rounded"
    android:orientation="vertical">

    <!-- Header area: Translucent dark tint for clear title -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_widget_header"
        android:padding="8dp">

        <TextView
            android:id="@+id/text_widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="sans-serif-medium"
            android:text="Vawiin Bible Chang"
            android:textColor="#1A237E"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btn_widget_refresh"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@android:drawable/ic_menu_rotate"
            android:padding="2dp"
            app:tint="#1A237E"
            android:contentDescription="Refresh" />
    </RelativeLayout>

    <!-- Content Area: 75% translucent white background (from root) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="12dp">

        <TextView
            android:id="@+id/text_widget_verse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bible chang kan zawng mek e..."
            android:textSize="15sp"
            android:textColor="#212121"
            android:maxLines="6"
            android:ellipsize="end"
            android:gravity="center" />

        <TextView
            android:id="@+id/text_widget_reference"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text=""
            android:textSize="12sp"
            android:textStyle="bold|italic"
            android:textColor="#1A237E" />
    </LinearLayout>

    <!-- Footer Area: Translucent dark tint for navigation -->
    <RelativeLayout
        android:id="@+id/layout_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_widget_footer"
        android:padding="4dp">

        <ImageView
            android:id="@+id/btn_widget_prev"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentStart="true"
            android:src="@android:drawable/ic_media_previous"
            android:padding="6dp"
            app:tint="#1A237E"
            android:contentDescription="Previous" />

        <ImageView
            android:id="@+id/btn_widget_next"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:src="@android:drawable/ic_media_next"
            android:padding="6dp"
            app:tint="#1A237E"
            android:contentDescription="Next" />
    </RelativeLayout>

</LinearLayout>
