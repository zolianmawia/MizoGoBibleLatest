<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bookmark_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="?attr/selectableItemBackground">

    <CheckBox
        android:id="@+id/checkbox_bookmark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:visibility="gone"
        android:clickable="false"
        android:focusable="false"
        tools:visibility="visible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="8dp">

        <TextView
            android:id="@+id/text_bookmark_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurface"
            android:textSize="12sp"
            android:textStyle="italic"
            android:alpha="0.8"
            android:layout_marginBottom="2dp"
            tools:text="Hemi hi ka bookmark chhan a ni e..." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/text_bookmark_reference"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="?attr/colorPrimary"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Genesis 1:1" />

            <TextView
                android:id="@+id/text_bookmark_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@color/mgb_version_background"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textColor="@color/mgb_version_text"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="MGB" />

            <TextView
                android:id="@+id/text_bookmark_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp"
                android:alpha="0.7"
                tools:text="29 Mar 2024" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_bookmark_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp"
            tools:text="Atir hmain Pathianin van leh lei a siam a." />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="?attr/colorOutlineVariant"
            android:alpha="0.2" />
    </LinearLayout>

</LinearLayout>