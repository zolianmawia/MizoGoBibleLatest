<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet_dialog"
    android:paddingHorizontal="20dp"
    android:paddingTop="8dp"
    android:paddingBottom="24dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_drag_handle" />

    <!-- Header Row: Verse Reference on left, - and + on right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/text_sheet_reference"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            tools:text="Johana 3:4" />

        <!-- Stepper Minus (-) -->
        <ImageView
            android:id="@+id/btn_sheet_minus"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_minus_bar"
            app:tint="?attr/colorPrimary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Remove verse" />

        <Space
            android:layout_width="16dp"
            android:layout_height="wrap_content" />

        <!-- Stepper Plus (+) -->
        <ImageView
            android:id="@+id/btn_sheet_plus"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_plus_bar"
            app:tint="?attr/colorPrimary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Add verse" />
    </LinearLayout>

    <!-- Verse Text Preview Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/verse_preview_card_bg">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:maxHeight="160dp">

            <TextView
                android:id="@+id/text_sheet_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:textColor="?attr/colorOnSurface"
                tools:text="Nikodeman a hnenah, &quot;Mi a upat hnuin engtinnge a pian theih ang? A nu pum chhungah a vawi hnihna lutin a piang leh thei em ni?&quot; a ti a." />
        </androidx.core.widget.NestedScrollView>
    </com.google.android.material.card.MaterialCardView>

    <!-- Pin Title -->
    <TextView
        android:id="@+id/text_pin_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pin: Pin rawng thlang rawh (Select Color)"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:layout_marginBottom="12dp" />

    <!-- Pin Color Swatches Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Red Pin (#FF5252) -->
        <ImageView
            android:id="@+id/pin_red"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="8dp"
            android:padding="6dp"
            android:src="@drawable/ic_pin_24"
            app:tint="#FF5252"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Red Pin" />

        <!-- Blue Pin (#448AFF) -->
        <ImageView
            android:id="@+id/pin_blue"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="8dp"
            android:padding="6dp"
            android:src="@drawable/ic_pin_24"
            app:tint="#448AFF"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Blue Pin" />

        <!-- Green Pin (#4CAF50) -->
        <ImageView
            android:id="@+id/pin_green"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="8dp"
            android:padding="6dp"
            android:src="@drawable/ic_pin_24"
            app:tint="#4CAF50"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Green Pin" />

        <!-- Yellow Pin (#FFD740) -->
        <ImageView
            android:id="@+id/pin_yellow"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="8dp"
            android:padding="6dp"
            android:src="@drawable/ic_pin_24"
            app:tint="#FFD740"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Yellow Pin" />

        <!-- Purple Pin (#E040FB) -->
        <ImageView
            android:id="@+id/pin_purple"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="8dp"
            android:padding="6dp"
            android:src="@drawable/ic_pin_24"
            app:tint="#E040FB"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Purple Pin" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <!-- Pin Activity / Fragment hawn nan (Open Pins) -->
        <ImageView
            android:id="@+id/btn_open_pins"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_menu_book_24"
            app:tint="?attr/colorPrimary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Pin Activity" />
    </LinearLayout>

    <!-- Bottom Actions Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        android:gravity="center">

        <!-- Copy Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_bottom_copy"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Copy"
            android:textSize="13sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_content_copy_24"
            app:iconSize="18dp"
            app:iconGravity="textStart"
            app:cornerRadius="24dp"
            app:strokeWidth="1.2dp"
            app:strokeColor="?attr/colorOutline"
            android:textColor="?attr/colorOnSurface"
            app:iconTint="?attr/colorOnSurface" />

        <!-- Bookmark Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_bottom_bookmark"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1.2"
            android:layout_marginEnd="8dp"
            android:text="Bookmarks"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="none"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            app:iconPadding="6dp"
            android:textStyle="bold"
            app:icon="@drawable/ic_bookmark_24"
            app:iconSize="18dp"
            app:iconGravity="textStart"
            app:cornerRadius="24dp"
            android:backgroundTint="@color/bookmark_action_btn_bg"
            android:textColor="#FFFFFF"
            app:iconTint="#FFFFFF" />

        <!-- Share Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_bottom_share"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Share"
            android:textSize="13sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_share_24"
            app:iconSize="18dp"
            app:iconGravity="textStart"
            app:cornerRadius="24dp"
            app:strokeWidth="1.2dp"
            app:strokeColor="?attr/colorOutline"
            android:textColor="?attr/colorOnSurface"
            app:iconTint="?attr/colorOnSurface" />
    </LinearLayout>

</LinearLayout>
