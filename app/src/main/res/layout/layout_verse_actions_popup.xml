<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="12dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardCornerRadius="32dp"
        app:cardElevation="12dp"
        app:strokeWidth="1.5dp"
        app:strokeColor="?attr/colorOutlineVariant"
        app:cardBackgroundColor="?attr/colorSurface">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="5dp"
            android:gravity="center_vertical">

            <!-- Stepper Container (- and + for adding/removing verses) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">

                <!-- Minus Button (-) -->
                <ImageView
                    android:id="@+id/action_remove_verse"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="6dp"
                    android:src="@drawable/ic_minus_bar"
                    android:background="@drawable/bg_stepper_circle"
                    android:contentDescription="Paih / Remove Verse"
                    app:tint="?attr/colorPrimary" />

                <!-- Selection Range / Verse Count text -->
                <TextView
                    android:id="@+id/text_selection_range"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="6dp"
                    android:gravity="center"
                    android:minWidth="34dp"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="v. 16" />

                <!-- Plus Button (+) -->
                <ImageView
                    android:id="@+id/action_add_verse"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="6dp"
                    android:src="@drawable/ic_plus_bar"
                    android:background="@drawable/bg_stepper_circle"
                    android:contentDescription="Belh / Add Verse"
                    app:tint="?attr/colorPrimary" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="1.5dp"
                android:layout_height="26dp"
                android:layout_marginHorizontal="6dp"
                android:background="?attr/colorOutlineVariant"
                android:alpha="0.5" />

            <!-- Copy Action -->
            <ImageView
                android:id="@+id/action_copy"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:src="@drawable/ic_content_copy_24"
                android:contentDescription="Copy"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="?attr/colorPrimary" />

            <!-- Bookmark Action -->
            <ImageView
                android:id="@+id/action_bookmark"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:src="@drawable/ic_bookmark_24"
                android:contentDescription="Bookmark"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="?attr/colorPrimary" />

            <!-- Share Action -->
            <ImageView
                android:id="@+id/action_share"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:src="@drawable/ic_share_24"
                android:contentDescription="Share"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="?attr/colorPrimary" />

            <!-- Note Action (hidden) -->
            <ImageView
                android:id="@+id/action_note"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="10dp"
                android:src="@drawable/notes"
                android:contentDescription="Note"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:visibility="gone"
                app:tint="?attr/colorPrimary" />

            <!-- Divider -->
            <View
                android:layout_width="1.5dp"
                android:layout_height="26dp"
                android:layout_marginHorizontal="6dp"
                android:background="?attr/colorOutlineVariant"
                android:alpha="0.5" />

            <!-- Clear Action (X) -->
            <ImageView
                android:id="@+id/action_clear"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="11dp"
                android:src="@drawable/ic_close_24"
                android:contentDescription="Clear"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#FF5252" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
