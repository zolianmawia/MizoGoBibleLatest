<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_date_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="42dp"
    android:background="?attr/selectableItemBackground">

    <com.zoliana.khampat.mizobible.ui.common.TreeConnectorView
        android:id="@+id/tree_connector"
        android:layout_width="38dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/text_date_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:textColor="?attr/colorOnSurface"
        android:textSize="15.5sp"
        android:paddingVertical="10dp"
        app:layout_constraintStart_toEndOf="@+id/tree_connector"
        app:layout_constraintEnd_toStartOf="@+id/icon_expand_chevron"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:text="Date: 24-09-2026 (18)" />

    <ImageView
        android:id="@+id/icon_expand_chevron"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="2dp"
        android:padding="4dp"
        android:src="@drawable/ic_chevron_right_24"
        app:tint="?attr/colorOnSurfaceVariant"
        android:contentDescription="Expand or collapse"
        app:layout_constraintEnd_toStartOf="@+id/btn_date_more"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/text_title_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/btn_date_more"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="8dp"
        android:padding="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_more_horiz_24"
        app:tint="?attr/colorPrimary"
        android:contentDescription="Date options"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
