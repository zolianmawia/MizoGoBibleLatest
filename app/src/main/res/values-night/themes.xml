<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark Mode Theme (#222333 Slate tones) -->
    <style name="Theme.MizoGoBible" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Main colors -->
        <item name="colorPrimary">#D3E4FF</item>
        <item name="colorOnPrimary">#00315C</item>

        <!-- Dark Background (#222333) -->
        <item name="android:windowBackground">#222333</item>
        <item name="colorSurface">#222333</item>
        <item name="colorOnSurface">#D3D4F2</item>

        <!-- Dark Variant for Search bar/containers -->
        <item name="colorSurfaceVariant">#2E2F45</item>
        <item name="colorOnSurfaceVariant">#C7C9DC</item>

        <item name="colorSecondaryContainer">#2E2F45</item>
        <item name="colorOnSecondaryContainer">#D3D4F2</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>

        <item name="elevationOverlayEnabled">false</item>
    </style>

    <!-- Top Sheet Dialog style - Fully Sync with Dark Earthy Theme -->
    <style name="Theme.MizoGoBible.TopSheet" parent="Theme.MizoGoBible">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.5</item>
        <item name="android:windowAnimationStyle">@style/Animation.TopSheet</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <!-- Overlay fixed: Using Dark for Night theme -->
    <style name="Theme.MizoGoBible.AppBarOverlay" parent="ThemeOverlay.Material3.Dark" />
    <style name="Theme.MizoGoBible.PopupOverlay" parent="ThemeOverlay.Material3.Dark" />

    <!-- Color Theme Variants (Night / Dark) -->
    <style name="Theme.MizoGoBible.NoActionBar.Blue" parent="Theme.MizoGoBible.NoActionBar">
        <item name="colorPrimary">#90CAF9</item>
        <item name="colorPrimaryContainer">#0D47A1</item>
        <item name="colorOnPrimary">#00315C</item>
        <item name="colorOnPrimaryContainer">#D3E4FF</item>
    </style>

